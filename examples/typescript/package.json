{
  "name": "@lmstream/reference",
  "version": "1.0.0",
  "description": "LMStream reference codec, vector runner, and client implementation",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/test/*.test.js",
    "generate-vectors": "tsc && node dist/scripts/generate-vectors.js",
    "verify-spec": "tsc && node dist/scripts/verify-spec-examples.js",
    "mock-server": "tsc && node dist/src/mock-server.js",
    "demo": "tsc && node dist/src/demo.js",
    "grpc-demo": "tsc && node dist/src/grpc-demo.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
